# Copia este archivo como .env.development (local) o .env.production (hosting) y completa los valores.
# NUNCA subas los .env reales a git ni los compartas.

# --- Servidor ---
PORT=8081
CORS_ORIGIN=http://localhost:3000        # URL exacta del front (un solo origen)
FRONTEND_URL=http://localhost:3000       # para los enlaces de los correos

# --- Base de datos (PostgreSQL / Neon) ---
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false                             # true en Neon

# --- JWT ---
JWT_SECRET=                              # cadena larga y aleatoria
JWT_EXPIRES_IN=1h
# QR_SECRET=                             # opcional: firma de los QR (por defecto usa JWT_SECRET)

# --- Reservas ---
SALE_HOLD_MINUTES=10                     # debe coincidir con HOLD_MIN del front (pago/[id]/page.js)

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=usd                      # moneda de cobro (gtq si tu cuenta la admite)
STRIPE_EXCHANGE_RATE=7.7                 # quetzales por 1 unidad de STRIPE_CURRENCY (ignorado si es gtq)

# --- Correo (Brevo) ---
# En Render gratis el SMTP esta bloqueado: usa la API (Brevo > SMTP y API > Claves API)
BREVO_API_KEY=
CONTACT_EMAIL=                           # donde llegan los mensajes del formulario de contacto (por defecto, el correo de MAIL_FROM)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=                               # login SMTP que muestra Brevo (SMTP y API > SMTP)
SMTP_PASS=                               # clave SMTP generada en Brevo
MAIL_FROM="Nebajpolis <tu-correo-verificado@dominio.com>"
